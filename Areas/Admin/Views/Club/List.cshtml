@model List<Picklr.Models.Club>

@{
    ViewData["Title"] = "Clubs";
}

<h2 class="mt-3">Clubs</h2>

<a asp-action="AddEdit" class="btn btn-primary mb-3">
    Add Club
</a>

@if (TempData["message"] != null)
{
    <div class="alert alert-success">
        @TempData["message"]
    </div>
}

<table class="table table-bordered table-striped">

    <thead class="table-dark">

        <tr>
            <th>Club Name</th>
            <th>Location</th>
            <th>Description</th>
            <th style="width:90px;"></th>
            <th style="width:90px;"></th>
        </tr>

    </thead>

    <tbody>

        @foreach (var club in Model)
        {
            <tr>

                <td>@club.Name</td>

                <td>@club.Location</td>

                <td>@club.Description</td>

                <td>
                    <a asp-action="AddEdit"
                       asp-route-id="@club.ClubID"
                       class="btn btn-outline-primary btn-sm">
                        Edit
                    </a>
                </td>

                <td>
                    <a asp-action="Delete"
                       asp-route-id="@club.ClubID"
                       class="btn btn-outline-danger btn-sm">
                        Delete
                    </a>
                </td>

            </tr>
        }

    </tbody>

</table>