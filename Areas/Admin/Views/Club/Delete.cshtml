@model Picklr.Models.Club

@{
    ViewData["Title"] = "Delete Club";
}

<h2 class="mt-3">Delete Club</h2>

<div class="alert alert-danger">
    <h5>Are you sure you want to delete this club?</h5>
</div>

<table class="table table-bordered" style="max-width:700px;">

    <tr>
        <th style="width:200px;">Club Name</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Location</th>
        <td>@Model.Location</td>
    </tr>

    <tr>
        <th>Description</th>
        <td>@Model.Description</td>
    </tr>

</table>

<form asp-action="Delete" method="post">

    <input asp-for="ClubID" type="hidden" />
    <input asp-for="Name" type="hidden" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="List" class="btn btn-secondary">
        Cancel
    </a>

</form>