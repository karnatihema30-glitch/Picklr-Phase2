@model Picklr.Models.PicklProgram

@{
    ViewData["Title"] = "Delete Program";
}

<h2 class="mt-3">Delete Program</h2>

<div class="alert alert-danger">
    <h5>Are you sure you want to delete this program?</h5>
</div>

<table class="table table-bordered" style="max-width:700px;">

    <tr>
        <th style="width:200px;">Program</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Description</th>
        <td>@Model.Description</td>
    </tr>

    <tr>
        <th>Club</th>
        <td>@Model.Club?.Name</td>
    </tr>

    <tr>
        <th>Available Days</th>
        <td>@Model.AvailableDays</td>
    </tr>

    <tr>
        <th>Fee</th>
        <td>@Model.Fee.ToString("C")</td>
    </tr>

</table>

<form asp-action="Delete" method="post">

    <input asp-for="ProgramID" type="hidden" />
    <input asp-for="Name" type="hidden" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="List" class="btn btn-secondary">
        Cancel
    </a>

</form>