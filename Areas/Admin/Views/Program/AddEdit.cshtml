@model Picklr.Models.PicklProgram

@{
    ViewData["Title"] = ViewBag.Action + " Program";

    var selectedDays = string.IsNullOrEmpty(Model.AvailableDays)
        ? new List<string>()
        : Model.AvailableDays.Split(", ").ToList();

    string[] days =
    {
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
    };
}

<h2 class="mt-3">@ViewBag.Action Program</h2>

<form asp-action="AddEdit" method="post" style="max-width:700px;">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <input asp-for="ProgramID" type="hidden" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description"
                  class="form-control"
                  rows="3"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Fee" class="form-label"></label>

        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Fee" class="form-control" />
        </div>

        <span asp-validation-for="Fee" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Club</label>

        <select asp-for="ClubID"
                asp-items="ViewBag.Clubs"
                class="form-select">
            <option value="">Select a Club</option>
        </select>

        <span asp-validation-for="ClubID" class="text-danger"></span>
    </div>

    <div class="mb-3">

        <label class="form-label fw-bold d-block mb-2">
            Available Days
        </label>

        <div class="d-flex flex-wrap">

            @foreach (var day in days)
            {
                <div class="form-check me-4 mb-2">

                    <input class="form-check-input"
                           type="checkbox"
                           name="SelectedDays"
                           value="@day"
                           @(selectedDays.Contains(day) ? "checked" : null) />

                    <label class="form-check-label">
                        @day
                    </label>

                </div>
            }

        </div>

    </div>

    <button type="submit" class="btn btn-primary">
        @(ViewBag.Action == "Edit" ? "Save" : "Add")
    </button>

    <a asp-action="List"
       class="btn btn-secondary">
        Cancel
    </a>

</form>