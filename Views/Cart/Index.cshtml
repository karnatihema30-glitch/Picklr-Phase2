@model Picklr.Models.Cart

@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Your Cart";
}

<h2 class="mb-4">Your Reservations</h2>

@if (Model == null || !Model.Items.Any())
{
    <div class="alert alert-info">
        Your cart is empty.
    </div>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-success">
        Continue Browsing
    </a>
}
else
{
    <table class="table table-bordered">

        <thead class="table-light">
            <tr>
                <th>Program</th>
                <th>Club</th>
                <th>Date</th>
                <th>Fee</th>
                <th></th>
            </tr>
        </thead>

        <tbody>

        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProgramName</td>
                <td>@item.ClubName</td>
                <td>@item.Date</td>
                <td>@item.Fee.ToString("C")</td>

                <td>
                    <a asp-action="Remove"
                       asp-route-id="@item.ProgramID"
                       class="btn btn-outline-danger btn-sm">
                        Remove
                    </a>
                </td>
            </tr>
        }

        </tbody>

        <tfoot>
            <tr>
                <th colspan="3" class="text-end">
                    Total
                </th>

                <th>
                    @Model.Total.ToString("C")
                </th>

                <th></th>
            </tr>
        </tfoot>

    </table>

    <div class="mt-3">

        <a asp-action="PayConfirm"
           class="btn btn-success">
            Pay &amp; Confirm
        </a>

        <a asp-action="Clear"
           class="btn btn-outline-warning">
            Clear All
        </a>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary">
            Continue Browsing
        </a>

    </div>
}