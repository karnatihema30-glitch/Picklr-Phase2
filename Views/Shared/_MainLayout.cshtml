@using Picklr.Extensions
@using Picklr.Models
@{
    Layout = "_Layout";

    string ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<div class="container">

    <header>

        <nav class="navbar navbar-expand-md navbar-dark bg-success mt-2 rounded">

            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Picklr
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="mainNav">

                    <!-- Left Navigation -->
                    <div class="navbar-nav me-auto">

                        <a class="nav-item nav-link @(ctrl=="Home" && act=="About" ? "active" : "")"
                           asp-controller="Home"
                           asp-action="About">
                            About
                        </a>

                        <a class="nav-item nav-link"
                           asp-controller="Club"
                           asp-action="List">
                            Club
                        </a>

                        <a class="nav-item nav-link"
                           asp-controller="Program"
                           asp-action="List">
                            Program
                        </a>

                        <a class="nav-item nav-link"
                           asp-controller="Shop"
                           asp-action="Index">
                            Shop
                        </a>

                    </div>

                   <!-- Right Navigation -->
                    <div class="navbar-nav ms-auto align-items-center">

                        @{
                            var cart = Context.Session.GetObject<Picklr.Models.Cart>("Cart")
                                    ?? new Picklr.Models.Cart();
                        }

                        <a class="nav-link position-relative me-3"
                        asp-controller="Cart"
                        asp-action="Index">

                            <i class="fas fa-shopping-cart fa-lg"></i>

                            @if (cart.Count > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @cart.Count
                                </span>
                            }

                        </a>

                        <a class="nav-item nav-link"
                        asp-area="Admin"
                        asp-controller="Home"
                        asp-action="Index">
                            Admin
                        </a>

                    </div>

                </div>

            </div>

        </nav>

        @if (TempData["message"] != null)
        {
            <div class="alert alert-success mt-2 text-center">
                @TempData["message"]
            </div>
        }

    </header>

    <main class="mt-3">

        @RenderBody()

    </main>

    <footer class="mt-4 py-3 border-top text-center text-muted">

        <p>&copy; @DateTime.Now.Year Picklr — All rights reserved.</p>

    </footer>

</div>

@section Scripts
{
    @RenderSection("Scripts", required: false)
}