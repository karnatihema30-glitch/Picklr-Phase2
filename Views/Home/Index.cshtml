@model Picklr.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Programs";
}

<div class="row">

    <!-- Left Filter Panel -->
    <div class="col-md-4">

        <div class="filter-panel">

            <div class="filter-header">
                Filter Programs
            </div>

            <div class="filter-body">

                <form method="get">

                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            Club
                        </label>

                        <select name="clubId"
                                class="form-select"
                                asp-items="Model.Clubs">
                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            Date
                        </label>

                        <select name="date"
                                class="form-select"
                                asp-items="Model.Dates">
                        </select>

                    </div>

                    <button type="submit"
                            class="btn btn-success w-100 mb-2">
                        Search
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary w-100">
                        Clear
                    </a>

                </form>

            </div>

        </div>

    </div>

    <!-- Right Program List -->
    <div class="col-md-8">

        <h1 class="mb-4">
            @Model.PageTitle
        </h1>

        @if (Model.Programs.Any())
        {
            <table class="table table-bordered program-table">

                <thead>
                    <tr>
                        <th>Program</th>
                        <th>Club</th>
                        <th>Fee</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                @foreach (var item in Model.Programs)
                {
                    <tr>

                        <td>
                            <strong>@item.Name</strong><br />
                            @item.Description
                        </td>

                        <td>
                            @item.Club?.Name
                        </td>

                        <td>
                            @item.Fee.ToString("C")
                        </td>

                        <td>
                            <a asp-controller="Cart"
                               asp-action="Add"
                               asp-route-id="@item.ProgramID"
                               asp-route-clubId="@Model.ClubId"
                               asp-route-date="@Model.Date"
                               class="btn btn-success reserve-btn">
                                Reserve
                            </a>
                        </td>

                    </tr>
                }

                </tbody>

            </table>
        }
        else
        {
            <div class="alert alert-info">
                No programs are available on this date.
            </div>
        }

    </div>

</div>